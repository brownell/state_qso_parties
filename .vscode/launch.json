{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Batch app",
            "type": "debugpy",
            "request": "launch",
            "program": "batch.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "Gen Final Rpt (batch)",
            "type": "debugpy",
            "request": "launch",
            "program": "generate_final_report.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python"
        },
        {
            "name": "Generate Rankings (batch)",
            "type": "debugpy",
            "request": "launch",
            "program": "generate_rankings.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python"
        },
        {
            "name": "Cross Check (batch)",
            "type": "debugpy",
            "request": "launch",
            "program": "cross_check.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python"
        },
        {
            "name": "WIN Batch app",
            "type": "debugpy",
            "request": "launch",
            "program": "batch.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
        },
        {
            "name": "WIN Final Report (batch)",
            "type": "debugpy",
            "request": "launch",
            "program": "final_report.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
        },        
        {
            "name": "Web app",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "web.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "WIN Web app",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "env": {
                "FLASK_APP": "web.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "justMyCode": true
        }
        
    ]
}