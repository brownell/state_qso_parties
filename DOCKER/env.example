# Louisiana QSO Party - Environment Variables
# Copy this file to .env and update with your values

# Flask Secret Key (CHANGE THIS!)
SECRET_KEY=your-secret-key-here-change-in-production

# Contest Year
CONTEST_YEAR=2026

# Database Path (inside container)
DATABASE_PATH=/app/database/txqp.db

# Upload Settings
UPLOAD_FOLDER=/app/logs/incoming
MAX_UPLOAD_SIZE=5242880

# HTML Results
HTML_RESULTS_DIR=/app/HTML_RESULTS

# Temporary Files
TEMP_DIR=/app/temp

# Gunicorn Settings
WORKERS=4
TIMEOUT=120

# Optional: External URL (for emails, etc.)
# EXTERNAL_URL=https://txqp.example.com
